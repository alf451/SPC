DATABASE_URL=postgresql+asyncpg://leank_spc:changeme@localhost:5432/leank_spc
# BACKEND_HOST=127.0.0.1 -> solo questo PC. 0.0.0.0 -> raggiungibile anche da
# altre macchine della rete su BACKEND_PORT (ricordarsi di aprire la porta sul
# firewall e di usare l'IP/nome di questa macchina, non "localhost", dai PC remoti)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Impostare entrambe per servire HTTPS invece di HTTP (percorsi a file .pem;
# generare una coppia auto-firmata per la LAN con "python generate_cert.py
# cert.pem key.pem <hostname> [ip...]", oppure indicare un certificato vero
# per l'esposizione pubblica). Lasciare vuote/assenti per restare in HTTP.
# BACKEND_SSL_CERTFILE=/percorso/a/cert.pem
# BACKEND_SSL_KEYFILE=/percorso/a/key.pem
JWT_SECRET=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000,null
